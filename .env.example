# Reference template only; run scripts/initialize-demo-env.ps1 to generate valid ignored local credentials.
# Do not copy these replace-* placeholders directly into .env.
MYSQL_APP_USER=moneypal_app
MYSQL_APP_PASSWORD=replace-with-a-random-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-local-password
JWT_SECRET=replace-with-a-base64-encoded-random-64-byte-key
MFA_ENCRYPTION_KEY=replace-with-a-separate-stable-random-secret
# Optional legacy PostgreSQL backend connection (for scripts/run-backend.ps1).
SUPABASE_DB_URL=jdbc:postgresql://your-supabase-pooler:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=your-supabase-database-user
SUPABASE_DB_PASSWORD=replace-with-your-database-password
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_FROM="Banking Lab <no-reply@example.com>"
PASSWORD_RESET_URL=http://localhost:4200/reset-password?token=
PASSWORD_RESET_API_URL=https://api.brevo.com/v3/smtp/email
PASSWORD_RESET_API_KEY=

# Demo opening credits are disabled unless explicitly enabled for a local demonstration.
# Staff-only demo opening credits. Keep disabled outside local demonstrations.
# APP_DEMO_OPENING_BALANCE_ENABLED=false
# Optional demonstration-only maximum amount; unset means no configured cap.
# APP_DEMO_OPENING_MAX_AMOUNT=

# Static demo exchange rates. Format: FUNDING/DESTINATION=RATE; separate pairs with commas.
# The default INR/USD rate matches the Product Builder's sample preview rate and is not live.
APP_FOREX_REFERENCE_RATES=INR/USD=83.25

# Default risk for new customer profiles.
CUSTOMER_DEFAULT_RISK_CATEGORY=LOW
# Optional MPIN controls. A dedicated pepper is optional; otherwise it is derived from MFA_ENCRYPTION_KEY.
# MPIN_PEPPER=
MPIN_MAX_ATTEMPTS=5
MPIN_LOCK_MINUTES=30
# MPIN enforcement rollback switch. Keep enabled outside rollback testing.
APP_MPIN_REQUIRED=true

# Demo FD schedule: interest at midnight and maturity processing at 1 a.m. India time.
# Advancing the admin business clock still runs the batch immediately.
FD_BATCH_SCHEDULE_ENABLED=true
FD_BATCH_INTEREST_CRON="0 0 0 * * *"
FD_BATCH_MATURITY_CRON="0 0 1 * * *"
FD_BATCH_ZONE=Asia/Kolkata
FD_BUSINESS_ZONE=Asia/Kolkata
